# Set these in Cloudflare Workers & Pages settings. Do not commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CALENDAR_FEED_ENCRYPTION_KEY=generate-a-unique-high-entropy-secret
# Optional FS91 lifecycle enforcement. Configure URL and service token together;
# partial configuration fails closed. The adapter token authorizes central,
# server-to-server inventory requests and must be a separate random secret.
FS91_ACCOUNT_LIFECYCLE_URL=https://accounts.example.com
FS91_ACCOUNT_LIFECYCLE_SERVICE_TOKEN=server-to-server-lifecycle-token
FS91_ACCOUNT_LIFECYCLE_ADAPTER_TOKEN=separate-law18ref-inventory-token
# Public widget identifier. Leave unset until Turnstile is also enabled in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
